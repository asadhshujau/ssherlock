[
  {
    "context": "Pane",
    "bindings": {
      "mod-t": "pane::NewTab",
      "mod-w": "pane::CloseTab",
      "ctrl-tab": "pane::NextTab",
      "ctrl-shift-tab": "pane::PreviousTab",
      "ctrl-pagedown": "pane::NextTab",
      "ctrl-pageup": "pane::PreviousTab",
      "ctrl-shift-pageup": "pane::MoveTabLeft",
      "ctrl-shift-pagedown": "pane::MoveTabRight",
      "mod-r": "pane::RenameTab",
      "mod-o": "ssh::QuickConnect"
    }
  },
  {
    "context": "Pane",
    "os": ["linux", "windows"],
    "bindings": {
      "mod-h": "pane::ShowHosts"
    }
  },
  {
    "context": "Pane",
    "os": ["macos"],
    "bindings": {
      "cmd-shift-h": "pane::ShowHosts"
    }
  },
  {
    "context": "HostsPage",
    "bindings": {
      "tab": "form::FocusNext",
      "shift-tab": "form::FocusPrevious",
      "secondary-f": "hosts::FocusSearch"
    }
  },
  {
    "context": "HostNav",
    "bindings": {
      "down": "hosts::SelectNext",
      "up": "hosts::SelectPrevious",
      "home": "hosts::SelectFirst",
      "end": "hosts::SelectLast",
      "right": "hosts::ExpandGroup",
      "left": "hosts::CollapseGroup",
      "enter": "hosts::FocusList",
      "/": "hosts::FocusSearch",
      "n": "hosts::NewHost",
      "shift-n": "hosts::NewGroup",
      "e": "hosts::EditSelected",
      "f2": "hosts::EditSelected",
      "delete": "hosts::TrashGroup"
    }
  },
  {
    "context": "HostSearch",
    "bindings": {
      "down": "hosts::FocusList",
      "enter": "hosts::FocusList",
      "escape": "hosts::ClearSearch"
    }
  },
  {
    "context": "HostList",
    "bindings": {
      "down": "hosts::SelectNext",
      "up": "hosts::SelectPrevious",
      "right": "hosts::SelectNext",
      "left": "hosts::SelectPrevious",
      "home": "hosts::SelectFirst",
      "end": "hosts::SelectLast",
      "shift-down": "hosts::ExtendNext",
      "shift-up": "hosts::ExtendPrevious",
      "shift-home": "hosts::ExtendToFirst",
      "shift-end": "hosts::ExtendToLast",
      "space": "hosts::ToggleSelected",
      "secondary-a": "hosts::SelectAll",
      "escape": "hosts::ClearSelection",
      "enter": "hosts::ConnectSelected",
      "f": "hosts::ToggleFavourite",
      "delete": "hosts::TrashSelected",
      "backspace": "hosts::TrashSelected",
      "s": "hosts::ChangeSort",
      "v": "hosts::ToggleLayout",
      "/": "hosts::FocusSearch",
      "n": "hosts::NewHost",
      "shift-n": "hosts::NewGroup",
      "e": "hosts::EditSelected",
      "f2": "hosts::EditSelected",
      "secondary-d": "hosts::DuplicateSelected",
      "m": "hosts::MoveToGroup"
    }
  },
  {
    "context": "HostEditor",
    "bindings": {
      "enter": "hosts::SaveEditor",
      "secondary-enter": "hosts::SaveEditor",
      "secondary-s": "hosts::SaveEditor",
      "escape": "hosts::CancelEditor"
    }
  },
  {
    "context": "Trash",
    "bindings": {
      "down": "hosts::SelectNext",
      "up": "hosts::SelectPrevious",
      "home": "hosts::SelectFirst",
      "end": "hosts::SelectLast",
      "enter": "hosts::Restore",
      "r": "hosts::Restore",
      "shift-delete": "hosts::DeleteForever",
      "secondary-shift-delete": "hosts::EmptyTrash",
      "/": "hosts::FocusSearch"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "mod-c": "terminal::Copy",
      "mod-v": "terminal::Paste",
      "shift-insert": "terminal::Paste",
      "shift-pageup": "terminal::ScrollPageUp",
      "shift-pagedown": "terminal::ScrollPageDown",
      "shift-home": "terminal::ScrollToTop",
      "shift-end": "terminal::ScrollToBottom",
      "mod-up": "terminal::ScrollLineUp",
      "mod-down": "terminal::ScrollLineDown",
      "mod-k": "terminal::ClearScrollback",
      "mod-f": "terminal::Find",
      "secondary-=": "terminal::ZoomIn",
      "secondary-+": "terminal::ZoomIn",
      "secondary--": "terminal::ZoomOut",
      "secondary-0": "terminal::ResetZoom"
    }
  },
  {
    "context": "Terminal",
    "os": ["macos"],
    "bindings": {
      "cmd-alt-r": "terminal::ResetTerminal"
    }
  },
  {
    "context": "Terminal",
    "os": ["linux", "windows"],
    "bindings": {
      "ctrl-shift-delete": "terminal::ResetTerminal"
    }
  },
  {
    "context": "Modal",
    "bindings": {
      "enter": "modal::Confirm",
      "escape": "modal::Cancel"
    }
  },
  {
    "context": "ContextMenu",
    "bindings": {
      "down": "menu::SelectNext",
      "up": "menu::SelectPrevious",
      "enter": "menu::ConfirmItem",
      "escape": "menu::Dismiss"
    }
  },
  {
    "context": "TextInput",
    "bindings": {
      "secondary-v": "text_input::Paste",
      "shift-insert": "text_input::Paste",
      "secondary-c": "text_input::Copy",
      "secondary-x": "text_input::Cut",
      "secondary-a": "text_input::SelectAll"
    }
  },
  {
    "context": "TextInput && multiline",
    "bindings": {
      "enter": "text_input::Newline"
    }
  },
  {
    "context": "Form",
    "bindings": {
      "tab": "form::FocusNext",
      "shift-tab": "form::FocusPrevious"
    }
  },
  {
    "context": "Button",
    "bindings": {
      "enter": "form::Activate",
      "space": "form::Activate"
    }
  },
  {
    "context": "Checkbox",
    "bindings": {
      "space": "form::Toggle"
    }
  },
  {
    "context": "SegmentedControl",
    "bindings": {
      "right": "menu::SelectNext",
      "left": "menu::SelectPrevious"
    }
  },
  {
    "context": "Picker",
    "bindings": {
      "down": "menu::SelectNext",
      "up": "menu::SelectPrevious",
      "enter": "menu::ConfirmItem",
      "escape": "menu::Dismiss"
    }
  },
  {
    "context": "TerminalSearch",
    "bindings": {
      "enter": "terminal::SearchOlder",
      "shift-enter": "terminal::SearchNewer",
      "escape": "terminal::DismissSearch",
      "mod-f": "terminal::Find"
    }
  }
]
