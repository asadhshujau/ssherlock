[
  {
    "context": "Pane",
    "bindings": {
      "mod-t": "pane::NewTab",
      "mod-w": "pane::CloseTab",
      "ctrl-tab": "pane::NextTab",
      "ctrl-shift-tab": "pane::PreviousTab",
      "ctrl-pagedown": "pane::NextTab",
      "ctrl-pageup": "pane::PreviousTab",
      "ctrl-shift-pageup": "pane::MoveTabLeft",
      "ctrl-shift-pagedown": "pane::MoveTabRight",
      "mod-r": "pane::RenameTab"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "mod-c": "terminal::Copy",
      "mod-v": "terminal::Paste",
      "shift-insert": "terminal::Paste",
      "shift-pageup": "terminal::ScrollPageUp",
      "shift-pagedown": "terminal::ScrollPageDown",
      "shift-home": "terminal::ScrollToTop",
      "shift-end": "terminal::ScrollToBottom",
      "mod-up": "terminal::ScrollLineUp",
      "mod-down": "terminal::ScrollLineDown",
      "mod-k": "terminal::ClearScrollback",
      "mod-alt-r": "terminal::ResetTerminal",
      "mod-f": "terminal::Find"
    }
  },
  {
    "context": "TerminalSearch",
    "bindings": {
      "enter": "terminal::SearchOlder",
      "shift-enter": "terminal::SearchNewer",
      "escape": "terminal::DismissSearch",
      "mod-f": "terminal::Find"
    }
  }
]
